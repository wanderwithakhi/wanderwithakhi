---
import { getAllPosts, urlFor } from '../utils/sanity';
import { getCollection } from 'astro:content';
import ArticleCard from './ArticleCard.astro';

let travelPosts = [];
let mindfulnessPosts = [];
let wellnessPosts = [];

// Fetch local collections
const localTravel = await getCollection('travel');
const localMindfulness = await getCollection('mindfulness');
const localWellness = await getCollection('wellness');

const localTravelMapped = localTravel.map(p => ({ id: p.id, section: 'travel', data: p.data }));
const localMindfulnessMapped = localMindfulness.map(p => ({ id: p.id, section: 'mindfulness', data: p.data }));
const localWellnessMapped = localWellness.map(p => ({ id: p.id, section: 'wellness', data: p.data }));

let sanityTravel = [];
let sanityMindfulness = [];
let sanityWellness = [];

try {
  const sanityPosts = await getAllPosts();
  
  if (sanityPosts && sanityPosts.length > 0) {
    // Map Sanity documents to the unified structure
    const mappedPosts = sanityPosts.map((post: any) => {
      const coverUrl = post.coverImage ? urlFor(post.coverImage).url() : undefined;
      return {
        id: post.slug,
        section: post.section,
        data: {
          title: post.title,
          description: post.description,
          publishDate: new Date(post.publishDate),
          category: post.category,
          location: post.location,
          duration: post.duration,
          coverImage: coverUrl
        }
      };
    });

    sanityTravel = mappedPosts.filter((p: any) => p.section === 'travel');
    sanityMindfulness = mappedPosts.filter((p: any) => p.section === 'mindfulness');
    sanityWellness = mappedPosts.filter((p: any) => p.section === 'wellness');
  }
} catch (e) {
  console.error('[Sanity] failed to fetch posts for homepage:', e);
}

// Merge helper: prevents duplicates by using slug as map key, overriding local with Sanity
const mergePosts = (localList, sanityList) => {
  const mergedMap = new Map();
  localList.forEach(p => mergedMap.set(p.id, p));
  sanityList.forEach(p => mergedMap.set(p.id, p));
  return Array.from(mergedMap.values());
};

travelPosts = mergePosts(localTravelMapped, sanityTravel);
mindfulnessPosts = mergePosts(localMindfulnessMapped, sanityMindfulness);
wellnessPosts = mergePosts(localWellnessMapped, sanityWellness);

// Sort posts by date (newest first)
const sortedTravel = travelPosts.sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime());
const sortedMindfulness = mindfulnessPosts.sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime());
const sortedWellness = wellnessPosts.sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime());
---

<div class="articles-feed-wrapper" id="articlesFeedWrapper">
  <!-- Active Filter Notification Bar -->
  <div class="filter-status-bar" id="filterStatusBar" style="display: none;">
    <div class="container status-bar-container">
      <span class="filter-message" id="filterStatusMessage">
        Filtering posts
      </span>
      <button class="clear-filter-btn" id="clearFilterBtn">
        Clear Filter
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>

  <!-- Outside Section -->
  <section class="feed-section section-outside" id="outside">
    <div class="container">
      <div class="section-header">
        <h3 class="section-title">The Outside</h3>
        <p class="section-subtitle">Coordinates, Slow Guides, and Earthly Discoveries</p>
        
        <!-- Continent Filters -->
        <div class="region-filter-bar">
          <a href="#outside" class="region-pill active" data-region="all">All</a>
          <a href="#outside?region=asia" class="region-pill" data-region="asia">Asia</a>
          <a href="#outside?region=europe" class="region-pill" data-region="europe">Europe</a>
          <a href="#outside?region=americas" class="region-pill" data-region="americas">Americas</a>
          <a href="#outside?region=africa" class="region-pill" data-region="africa">Africa</a>
        </div>

        <!-- Country Sub-Filters (Dynamically shown based on selected continent) -->
        <div class="country-filter-bar" id="countryFilterBar" style="display: none;">
          <span class="country-filter-label">Filter by Country:</span>
          
          <!-- Asia -->
          <div class="country-group" data-continent="asia" style="display: none;">
            <a href="#outside?region=asia" class="country-pill active" data-country="all">All Asia</a>
            <a href="#outside?region=asia&country=india" class="country-pill" data-country="india">India</a>
            <a href="#outside?region=asia&country=japan" class="country-pill" data-country="japan">Japan</a>
            <a href="#outside?region=asia&country=vietnam" class="country-pill" data-country="vietnam">Vietnam</a>
          </div>

          <!-- Europe -->
          <div class="country-group" data-continent="europe" style="display: none;">
            <a href="#outside?region=europe" class="country-pill active" data-country="all">All Europe</a>
            <a href="#outside?region=europe&country=germany" class="country-pill" data-country="germany">Germany</a>
            <a href="#outside?region=europe&country=italy" class="country-pill" data-country="italy">Italy</a>
            <a href="#outside?region=europe&country=scotland" class="country-pill" data-country="scotland">Scotland</a>
            <a href="#outside?region=europe&country=iceland" class="country-pill" data-country="iceland">Iceland</a>
          </div>

          <!-- Americas -->
          <div class="country-group" data-continent="americas" style="display: none;">
            <a href="#outside?region=americas" class="country-pill active" data-country="all">All Americas</a>
            <a href="#outside?region=americas&country=chile" class="country-pill" data-country="chile">Chile</a>
            <a href="#outside?region=americas&country=costa-rica" class="country-pill" data-country="costa-rica">Costa Rica</a>
          </div>

          <!-- Africa -->
          <div class="country-group" data-continent="africa" style="display: none;">
            <a href="#outside?region=africa" class="country-pill active" data-country="all">All Africa</a>
            <a href="#outside?region=africa&country=morocco" class="country-pill" data-country="morocco">Morocco</a>
          </div>
        </div>
      </div>

      <div class="grid-editorial">
        {sortedTravel.map(post => (
          <ArticleCard
            title={post.data.title}
            description={post.data.description}
            publishDate={post.data.publishDate}
            category={post.data.category}
            location={post.data.location}
            duration={post.data.duration}
            slug={post.id}
            type="travel"
          />
        ))}
      </div>
    </div>
  </section>

  <!-- Premium Guide Promotional Banner -->
  <section class="guide-callout-banner" id="guideCalloutBanner">
    <div class="container callout-container">
      <div class="callout-mockup-wrapper">
        <div class="mini-book-mockup">
          <div class="mini-book-spine"></div>
          <div class="mini-book-cover">
            <span class="mini-mockup-brand">Akhi</span>
            <h4 class="mini-mockup-title">Nervous<br/>System<br/>Reset</h4>
            <span class="mini-mockup-author">Guide</span>
          </div>
        </div>
      </div>
      <div class="callout-content">
        <span class="callout-tag">Digital Workbook</span>
        <h3 class="callout-title">Nervous System Reset: A 7-Day Somatic Guide</h3>
        <p class="callout-description">Decompress travel anxiety, restore digestive flow, and find grounding on the move. Explore our premium interactive guide and worksheets.</p>
        <a href="/guide" class="callout-btn">Check Digital Product</a>
      </div>
    </div>
  </section>

  <!-- Inside Section -->
  <section class="feed-section section-inside" id="inside">
    <div class="container">
      <div class="section-header">
        <h3 class="section-title">The Inside</h3>
        <p class="section-subtitle">Mindful Reflections, Breathwork, and Somatic Grounding</p>
      </div>

      <div class="grid-editorial">
        {sortedMindfulness.map(post => (
          <ArticleCard
            title={post.data.title}
            description={post.data.description}
            publishDate={post.data.publishDate}
            category={post.data.category}
            duration={post.data.duration}
            slug={post.id}
            type="mindfulness"
          />
        ))}
      </div>
    </div>
  </section>

  <!-- Wellness Section -->
  <section class="feed-section section-wellness" id="wellness">
    <div class="container">
      <div class="section-header">
        <h3 class="section-title">Wellness</h3>
        <p class="section-subtitle">Slow Living, Conscious Habits, and Plant-Based Nutrition</p>
      </div>

      <div class="grid-editorial">
        {sortedWellness.map(post => (
          <ArticleCard
            title={post.data.title}
            description={post.data.description}
            publishDate={post.data.publishDate}
            category={post.data.category}
            duration={post.data.duration}
            slug={post.id}
            type="mindfulness" 
          />
        ))}
      </div>
    </div>
  </section>
</div>

<style>
  .articles-feed-wrapper {
    background-color: var(--color-bg);
    transition: background-color 0.8s ease;
    position: relative;
  }

  /* Active Filter Notification Bar styling */
  .filter-status-bar {
    background-color: var(--color-accent);
    color: var(--palette-chalk);
    padding: 0.75rem 0;
    font-family: var(--font-sans);
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    position: sticky;
    top: 72px; /* right below navigation header */
    z-index: 50;
    animation: slideDown 0.4s cubic-bezier(0.25, 1, 0.5, 1);
  }

  @keyframes slideDown {
    from { transform: translateY(-100%); }
    to { transform: translateY(0); }
  }

  .status-bar-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .clear-filter-btn {
    background: transparent;
    border: 1px solid var(--palette-chalk);
    color: var(--palette-chalk);
    padding: 0.25rem 0.75rem;
    font-size: 0.75rem;
    text-transform: uppercase;
    font-weight: 700;
    letter-spacing: 0.05em;
    border-radius: 4px;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    transition: var(--transition-smooth);
  }

  .clear-filter-btn:hover {
    background-color: var(--palette-chalk);
    color: var(--color-accent);
  }

  .feed-section {
    padding: 6rem 0;
    transition: opacity 0.4s ease, display 0.4s ease;
  }

  .section-outside {
    border-bottom: var(--border-thin);
  }

  .section-inside {
    border-bottom: var(--border-thin);
    background-color: rgba(85, 107, 47, 0.03); /* Soft sage tint */
  }

  .section-wellness {
    border-bottom: var(--border-thin);
    background-color: transparent;
  }

  .section-header {
    margin-bottom: 3.5rem;
    text-align: left;
  }

  .section-title {
    font-size: 2.5rem;
    margin-bottom: 0.5rem;
    color: var(--color-text);
  }

  .section-outside .section-title {
    color: var(--palette-rust);
  }

  .section-inside .section-title {
    color: var(--palette-sage);
  }

  .section-wellness .section-title {
    color: var(--palette-ochre);
  }

  .section-subtitle {
    font-family: var(--font-editorial);
    font-style: italic;
    font-size: 1.25rem;
    opacity: 0.7;
    margin: 0;
  }

  /* Region Filters Bar */
  .region-filter-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.75rem;
  }

  .region-pill {
    font-family: var(--font-sans);
    font-size: 0.72rem;
    text-transform: uppercase;
    font-weight: 700;
    letter-spacing: 0.05em;
    padding: 0.45rem 1.15rem;
    border: var(--border-thin);
    border-radius: 50px;
    color: var(--color-text);
    opacity: 0.6;
    transition: var(--transition-smooth);
    cursor: pointer;
    background-color: transparent;
    text-decoration: none;
  }

  .region-pill:hover, .region-pill.active {
    opacity: 1;
    border-color: var(--palette-rust);
    color: var(--palette-rust);
    background-color: rgba(200, 122, 83, 0.03);
  }

  /* Guide Callout Banner styling */
  .guide-callout-banner {
    background-color: var(--palette-chalk);
    border-bottom: var(--border-thin);
    padding: 5rem 1.5rem;
    transition: background-color 0.8s ease;
  }

  .callout-container {
    max-width: 900px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3rem;
    width: 100%;
  }

  @media (min-width: 768px) {
    .callout-container {
      flex-direction: row;
      justify-content: space-between;
      text-align: left;
    }
  }

  .callout-mockup-wrapper {
    display: flex;
    justify-content: center;
    align-items: center;
    flex-shrink: 0;
  }

  .mini-book-mockup {
    width: 150px;
    height: 210px;
    display: flex;
    box-shadow: 10px 10px 20px rgba(0,0,0,0.05);
    border-radius: 0 4px 4px 0;
    overflow: hidden;
    background-color: var(--palette-rust);
  }

  .mini-book-spine {
    width: 10px;
    background: linear-gradient(90deg, rgba(0,0,0,0.15) 0%, rgba(255,255,255,0.08) 50%, rgba(0,0,0,0.2) 100%);
    border-right: 1px solid rgba(0,0,0,0.1);
  }

  .mini-book-cover {
    flex-grow: 1;
    background: var(--palette-rust);
    padding: 1.5rem 1rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    color: #fff;
  }

  .mini-mockup-brand {
    font-family: var(--font-sans);
    font-size: 0.45rem;
    text-transform: uppercase;
    font-weight: 700;
    letter-spacing: 0.1em;
    opacity: 0.8;
  }

  .mini-mockup-title {
    font-family: var(--font-sans);
    font-size: 1.15rem;
    line-height: 1.1;
    font-weight: 700;
  }

  .mini-mockup-author {
    font-family: var(--font-sans);
    font-size: 0.5rem;
    font-weight: 600;
    text-transform: uppercase;
    opacity: 0.8;
  }

  .callout-content {
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  @media (min-width: 768px) {
    .callout-content {
      align-items: flex-start;
      margin-left: 2rem;
    }
  }

  .callout-tag {
    font-family: var(--font-sans);
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--palette-rust);
    margin-bottom: 0.75rem;
  }

  .callout-title {
    font-size: 1.75rem;
    margin-bottom: 0.75rem;
    color: var(--color-text);
  }

  .callout-description {
    font-family: var(--font-serif);
    font-size: 1.1rem;
    line-height: 1.6;
    opacity: 0.75;
    margin-bottom: 2rem;
    max-width: 540px;
    text-align: center;
  }

  @media (min-width: 768px) {
    .callout-description {
      text-align: left;
    }
  }

  .callout-btn {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 0.85rem 2rem;
    background-color: var(--palette-rust);
    color: #fff;
    border: none;
    border-radius: 4px;
    text-decoration: none;
    transition: var(--transition-smooth);
    box-shadow: 0 4px 10px rgba(200, 122, 83, 0.2);
    display: inline-block;
  }

  .callout-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 15px rgba(200, 122, 83, 0.3);
  }

  /* Country Sub-Filters Bar */
  .country-filter-bar {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-top: 1.25rem;
    padding-top: 1.25rem;
    border-top: 1px solid rgba(0,0,0,0.04);
    width: 100%;
    animation: filterFadeIn 0.3s ease;
  }

  @media (min-width: 600px) {
    .country-filter-bar {
      flex-direction: row;
      align-items: center;
    }
  }

  .country-filter-label {
    font-family: var(--font-sans);
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    opacity: 0.5;
    flex-shrink: 0;
  }

  .country-group {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .country-pill {
    font-family: var(--font-sans);
    font-size: 0.65rem;
    text-transform: uppercase;
    font-weight: 700;
    letter-spacing: 0.05em;
    padding: 0.35rem 0.95rem;
    border: var(--border-thin);
    border-radius: 4px;
    color: var(--color-text);
    opacity: 0.6;
    transition: var(--transition-smooth);
    cursor: pointer;
    background-color: transparent;
    text-decoration: none;
  }

  .country-pill:hover, .country-pill.active {
    opacity: 1;
    border-color: var(--palette-rust);
    color: var(--palette-rust);
    background-color: #fff;
    box-shadow: 0 2px 8px rgba(0,0,0,0.02);
  }

  @keyframes filterFadeIn {
    from { opacity: 0; transform: translateY(-4px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>

<script>
  // Upgraded Client-side nested filtering script
  const updateFilters = () => {
    const hash = window.location.hash;
    const statusBar = document.getElementById('filterStatusBar');
    const statusMessage = document.getElementById('filterStatusMessage');
    
    const outsideSec = document.getElementById('outside');
    const insideSec = document.getElementById('inside');
    const wellnessSec = document.getElementById('wellness');
    const cards = document.querySelectorAll('.article-card');

    const regionPills = document.querySelectorAll('.region-pill');
    const countryFilterBar = document.getElementById('countryFilterBar');
    const countryGroups = document.querySelectorAll('.country-group');
    const countryPills = document.querySelectorAll('.country-pill');

    let activeRegion = 'all';
    let activeCountry = 'all';
    let activeCategory = '';

    if (hash && hash.includes('?')) {
      const queryStr = hash.split('?')[1];
      const searchParams = new URLSearchParams(queryStr);
      
      if (searchParams.has('region')) {
        activeRegion = searchParams.get('region') || 'all';
      }
      if (searchParams.has('country')) {
        activeCountry = searchParams.get('country') || 'all';
      }
      if (searchParams.has('category')) {
        activeCategory = searchParams.get('category') || '';
      }
    }

    // Update Region Pills Active Class
    regionPills.forEach(pill => {
      const pillRegion = pill.getAttribute('data-region');
      if (pillRegion === activeRegion) {
        pill.classList.add('active');
      } else {
        pill.classList.remove('active');
      }
    });

    // Update Country Sub-Filter Bar visibility and country groups
    if (countryFilterBar) {
      if (activeRegion !== 'all') {
        countryFilterBar.style.display = 'flex';
        // Show matching continent country group, hide others
        countryGroups.forEach(group => {
          const continent = group.getAttribute('data-continent');
          if (continent === activeRegion) {
            (group as HTMLElement).style.display = 'flex';
          } else {
            (group as HTMLElement).style.display = 'none';
          }
        });

        // Update Active Country Pills
        countryPills.forEach(pill => {
          const pillCountry = pill.getAttribute('data-country');
          if (pillCountry === activeCountry) {
            pill.classList.add('active');
          } else {
            pill.classList.remove('active');
          }
        });
      } else {
        countryFilterBar.style.display = 'none';
      }
    }

    if (!hash || !hash.includes('?')) {
      // No filter active, show everything
      if (statusBar) statusBar.style.display = 'none';
      if (outsideSec) outsideSec.style.display = 'block';
      if (insideSec) insideSec.style.display = 'block';
      if (wellnessSec) wellnessSec.style.display = 'block';
      
      cards.forEach(card => {
        (card as HTMLElement).style.display = 'flex';
      });
      return;
    }

    // Parse section and query
    const parts = hash.split('?');
    const sectionId = parts[0].substring(1); // e.g. 'outside'

    // Show status bar
    if (statusBar && statusMessage) {
      statusBar.style.display = 'block';
      if (activeRegion !== 'all') {
        statusMessage.textContent = `Active Filter: ${sectionId} posts > Region: ${activeRegion}${activeCountry !== 'all' ? ` > Country: ${activeCountry}` : ''}`;
      } else if (activeCategory) {
        statusMessage.textContent = `Active Filter: ${sectionId} posts > Category: ${activeCategory}`;
      }
    }

    // Hide irrelevant sections
    if (outsideSec) outsideSec.style.display = (sectionId === 'outside') ? 'block' : 'none';
    if (insideSec) insideSec.style.display = (sectionId === 'inside') ? 'block' : 'none';
    if (wellnessSec) wellnessSec.style.display = (sectionId === 'wellness') ? 'block' : 'none';

    // Show/Hide cards inside the targeted section
    cards.forEach(card => {
      const cardEl = card as HTMLElement;
      const category = cardEl.getAttribute('data-category') || '';
      const region = cardEl.getAttribute('data-region') || '';
      const country = cardEl.getAttribute('data-country') || '';

      let isMatch = false;

      if (activeRegion !== 'all') {
        const matchesRegion = region === activeRegion;
        if (matchesRegion) {
          if (activeCountry !== 'all') {
            isMatch = country === activeCountry;
          } else {
            isMatch = true; // matches region, all countries visible
          }
        } else {
          isMatch = false;
        }
      } else if (activeCategory) {
        isMatch = category === activeCategory.toLowerCase().replace(' ', '-');
      }

      cardEl.style.display = isMatch ? 'flex' : 'none';
    });

    // Smooth-scroll directly to the active section
    const targetSection = document.getElementById(sectionId);
    if (targetSection) {
      targetSection.scrollIntoView({ behavior: 'smooth' });
    }
  };

  // Run on hash changes
  window.addEventListener('hashchange', updateFilters);
  
  // Run on initial load
  window.addEventListener('DOMContentLoaded', updateFilters);

  // Clear filters button
  const clearBtn = document.getElementById('clearFilterBtn');
  if (clearBtn) {
    clearBtn.addEventListener('click', () => {
      window.location.hash = '';
    });
  }
</script>
