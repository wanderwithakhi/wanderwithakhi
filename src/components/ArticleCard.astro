---
interface Props {
  title: string;
  description: string;
  publishDate: Date;
  category: string;
  duration: string;
  slug: string;
  type: 'travel' | 'mindfulness';
  location?: string;
}

const { title, description, publishDate, category, duration, slug, type, location } = Astro.props;

// Formatting Date
const formattedDate = new Date(publishDate).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
---

<article 
  class={`article-card card-${type}`}
  data-category={category.toLowerCase().replace(' ', '-').replace('&', 'and')}
  data-location={location ? location.toLowerCase() : ''}
>
  <div class="card-header">
    <span class="card-tag">{category}</span>
    {location && <span class="card-location">{location}</span>}
  </div>

  <h4 class="card-title">
    <a href={`/essays/${type}/${slug}`}>{title}</a>
  </h4>

  <p class="card-desc">{description}</p>

  <div class="card-footer">
    <time datetime={publishDate.toISOString()}>{formattedDate}</time>
    <span class="dot-separator">•</span>
    <span class="card-reading-time">{duration}</span>
  </div>
</article>

<style>
  .article-card {
    padding: 2.25rem 2rem;
    border: var(--border-thin);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 320px;
    background-color: var(--color-bg);
    transition: var(--transition-smooth), transform 0.4s ease;
    position: relative;
  }

  .article-card::before {
    content: '';
    position: absolute;
    top: -1px;
    left: -1px;
    right: -1px;
    height: 3px;
    background-color: transparent;
    transition: var(--transition-smooth);
  }

  /* Specific theme highlights based on content type */
  .card-travel:hover::before {
    background-color: var(--palette-rust);
  }

  .card-mindfulness:hover::before {
    background-color: var(--palette-sage);
  }

  .article-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 24px -10px rgba(18, 20, 17, 0.08);
    border-color: var(--color-accent);
  }

  /* Card Inner contents */
  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.25rem;
  }

  .card-tag {
    font-family: var(--font-sans);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 700;
  }

  .card-travel .card-tag {
    color: var(--palette-rust);
  }

  .card-mindfulness .card-tag {
    color: var(--palette-sage);
  }

  .card-location {
    font-size: 0.75rem;
    font-family: var(--font-editorial);
    font-style: italic;
    opacity: 0.6;
  }

  .card-title {
    font-size: 1.45rem;
    line-height: 1.25;
    margin-bottom: 1rem;
    letter-spacing: -0.02em;
    font-weight: 800;
  }

  .card-title a {
    color: var(--color-text);
  }

  .card-title a:hover {
    color: var(--color-accent);
  }

  .card-desc {
    font-size: 0.95rem;
    line-height: 1.6;
    opacity: 0.75;
    margin-bottom: 2rem;
    flex-grow: 1;
  }

  .card-footer {
    font-family: var(--font-sans);
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.75rem;
    opacity: 0.6;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .dot-separator {
    font-size: 0.6rem;
  }
</style>
