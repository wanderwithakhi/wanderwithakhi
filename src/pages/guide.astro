---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';

const products = [
  {
    id: "product_1_sadhana_journal",
    number: "01",
    title: "The Daily Sadhana & Asana Journal",
    subtitle: "A 30-Page Printable Practice Companion & Mindful Tracker",
    description: "Designed for dedicated practitioners and YTT students to log daily asana practice, pranayama retention times, meditation duration, and scriptural self-study (Svadhyaya).",
    badge: "Yoga & Meditation",
    color: "var(--palette-rust)",
    fullUrl: "/digital_products/product_1_sadhana_journal/full_30_pages.html",
    galleryUrl: "/digital_products/product_1_sadhana_journal/index.html",
    overview: [
      { pages: "Pages 1–3", title: "Cover & Sacred Intention (Sankalpa)", desc: "Set your daily practice commitment, dedication, and baseline energetic goals." },
      { pages: "Pages 4–8", title: "Philosophy & Asana Alignment Framework", desc: "Core Patanjali 8 Limbs breakdown, posture tracking, and injury prevention notes." },
      { pages: "Pages 9–24", title: "Daily Practice Log & Breathwork Meter", desc: "Grids for recording morning pranayama, meditation duration, and physical reflections." },
      { pages: "Pages 25–30", title: "Weekly Audit & Svadhyaya Notes", desc: "End-of-week reflection prompts, habit consistency charts, and integration space." }
    ]
  },
  {
    id: "product_2_somatic_planner",
    number: "02",
    title: "Somatic Stress Release & Recovery Planner",
    subtitle: "A 30-Page Workbook for Nervous System Regulation & Vagal Tone",
    description: "A somatic toolkit to down-regulate sympathetic fight-or-flight states, track Heart Rate Variability (HRV), release psoas tension, and build emotional resilience.",
    badge: "Somatic Therapy",
    color: "var(--palette-sage)",
    fullUrl: "/digital_products/product_2_somatic_planner/full_30_pages.html",
    galleryUrl: "/digital_products/product_2_somatic_planner/page1_cover.html",
    overview: [
      { pages: "Pages 1–3", title: "Autonomic Nervous System Diagnostic", desc: "Self-assessment checklist to identify Ventral Vagal, Sympathetic, or Dorsal Vagal freeze states." },
      { pages: "Pages 4–8", title: "Somatic Body Mapping Worksheets", desc: "Visual body outline diagrams to map physical stress stores (throat, chest, gut, shoulders)." },
      { pages: "Pages 9–24", title: "Daily Somatic Logging & Vagal Exercises", desc: "Daily trackers for constructive rest, eye-gazing releases, and diaphragmatic breathing." },
      { pages: "Pages 25–30", title: "Weekly Recovery Audits & Habit Loops", desc: "Progress tracking for HRV improvements, sleep quality, and physical tension release." }
    ]
  },
  {
    id: "product_3_dinacharya_guide",
    number: "03",
    title: "Dinacharya Ayurvedic Daily Routine Guide",
    subtitle: "A 30-Page Circadian Health & Self-Care Workbook",
    description: "Align your daily habits with classical Ayurvedic circadian wisdom. Features self-oil massage (Abhyanga) schedules, dosha balancing meal planners, and seasonal routines.",
    badge: "Ayurveda & Health",
    color: "var(--palette-ochre)",
    fullUrl: "/digital_products/product_3_dinacharya_guide/full_30_pages.html",
    galleryUrl: "/digital_products/product_3_dinacharya_guide/full_30_pages.html",
    overview: [
      { pages: "Pages 1–3", title: "Prakriti & Vikriti Dosha Diagnostic", desc: "Discover your baseline constitution (Vata, Pitta, Kapha) and current imbalances." },
      { pages: "Pages 4–8", title: "Circadian Clock & Dinacharya Schedule", desc: "Ideal morning, afternoon, and evening routine timings based on doshic peaks." },
      { pages: "Pages 9–24", title: "Daily Self-Care & Meal Planning Grids", desc: "Track tongue scraping, oil pulling, Abhyanga massage, and warm digestive meals." },
      { pages: "Pages 25–30", title: "Ritu Charya Seasonal Transition Guide", desc: "Protocols for adapting diet and yoga during spring, summer, monsoon, and autumn." }
    ]
  },
  {
    id: "product_4_slow_travel_journal",
    number: "04",
    title: "Slow Travel Journal & Intentional Planner",
    subtitle: "A 30-Page Mindful Companion for Conscious Explorers",
    description: "Transform your journeys into quiet, intentional immersions. Features minimalist packing capsules, travel anxiety grounding tools, and location reflection prompts.",
    badge: "Slow Travel",
    color: "var(--palette-rust)",
    fullUrl: "/digital_products/product_4_slow_travel_journal/full_30_pages.html",
    galleryUrl: "/digital_products/product_4_slow_travel_journal/full_30_pages.html",
    overview: [
      { pages: "Pages 1–3", title: "Travel Intention & Minimalist Manifesto", desc: "Define your trip's mental purpose and commitment to low-impact slow travel." },
      { pages: "Pages 4–8", title: "Ultralight Capsule Packing Checklists", desc: "Itemized 40L backpack packing grids for apparel, wellness items, and electronics." },
      { pages: "Pages 9–24", title: "Daily City Reflections & Quietcation Logs", desc: "Prompts for recording local sensory discoveries, cultural interactions, and quiet spots." },
      { pages: "Pages 25–30", title: "Post-Trip Integration & Memory Archive", desc: "Reflect on personal growth, mindset shifts, and lessons carried back home." }
    ]
  },
  {
    id: "product_5_lunar_planner",
    number: "05",
    title: "Lunar Cycle & Rhythm Planner",
    subtitle: "A 30-Page Guide to Syncing Sadhana with Moon Phases",
    description: "Harmonize your energy, yoga practice, and mental goals with the 29.5-day synodic lunar cycle. Ideal for moon day rest tracking and intention setting.",
    badge: "Lunar Wisdom",
    color: "var(--palette-sage)",
    fullUrl: "/digital_products/product_5_lunar_planner/full_30_pages.html",
    galleryUrl: "/digital_products/product_5_lunar_planner/full_30_pages.html",
    overview: [
      { pages: "Pages 1–3", title: "New Moon Intention Setting (Amavasya)", desc: "Plant seeds of intention, plant-based cleanses, and quiet meditation goals." },
      { pages: "Pages 4–8", title: "Waxing Phase Energy Building Grids", desc: "Track physical strength building, active asana practice, and focus momentum." },
      { pages: "Pages 9–24", title: "Full Moon Release Worksheets (Purnima)", desc: "Prompts for releasing emotional tension, rest day observance, and moon gazing." },
      { pages: "Pages 25–30", title: "28-Day Habit & Energy Correlation Chart", desc: "Correlate your sleep quality, mood, and stamina with exact lunar phases." }
    ]
  },
  {
    id: "product_6_chakra_journal",
    number: "06",
    title: "Chakra Energetic Alignment Journal",
    subtitle: "A 30-Page Subtle Body Diagnostic & Practice Workbook",
    description: "Explore the 7 primary energy centers (Muladhara through Sahasrara). Features self-diagnostic symptom logs, Bija mantra chanting guides, and mudra protocols.",
    badge: "Subtle Energy",
    color: "var(--palette-ochre)",
    fullUrl: "/digital_products/product_6_chakra_journal/full_30_pages.html",
    galleryUrl: "/digital_products/product_6_chakra_journal/full_30_pages.html",
    overview: [
      { pages: "Pages 1–3", title: "7 Chakra Diagnostic Self-Audit", desc: "Assess excess, deficiency, or balance across all seven subtle energy centers." },
      { pages: "Pages 4–8", title: "Root to Heart Chakra Alignment Pages", desc: "Specific asanas, seed mantras (LAM, VAM, RAM, YAM), and grounding visualizations." },
      { pages: "Pages 9–24", title: "Throat to Crown Elevation Worksheets", desc: "Chanting logs, visual focus exercises, and non-dual contemplation prompts." },
      { pages: "Pages 25–30", title: "Subtle Energy Balance Summary & Tracker", desc: "Weekly tracking for emotional clarity, intuitive alignment, and pranic flow." }
    ]
  },
  {
    id: "product_7_yin_somatic_guide",
    number: "07",
    title: "Yin & Somatic Self-Care Guide",
    subtitle: "A 30-Page Deep Fascia Release & Long-Hold Companion",
    description: "A printable companion for deep connective tissue hydration, Yin pose timing (3–5 minute holds), meridian line stimulation, and myofascial release.",
    badge: "Yin & Fascia",
    color: "var(--palette-rust)",
    fullUrl: "/digital_products/product_7_yin_somatic_guide/full_30_pages.html",
    galleryUrl: "/digital_products/product_7_yin_somatic_guide/full_30_pages.html",
    overview: [
      { pages: "Pages 1–3", title: "Principles of Yin & Fascial Anatomy", desc: "Learn the 3 rules of Yin: Yielding to gravity, finding your edge, and remaining motionless." },
      { pages: "Pages 4–8", title: "Meridian Line Diagnostic Charts", desc: "Target Kidney/Bladder, Liver/Gallbladder, and Stomach/Spleen energetic pathways." },
      { pages: "Pages 9–24", title: "Pose Timing & Sensation Intensity Logs", desc: "Track 3-to-5 minute pose holds (*Dragon*, *Butterfly*, *Caterpillar*) and emotional releases." },
      { pages: "Pages 25–30", title: "Rebound Observation & Restorative Integration", desc: "Record somatic sensations felt during neutral rebound poses." }
    ]
  }
];

const productsSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "Digital Practice Guides & Workbooks",
  "description": "30-page printable workbooks for daily sadhana, somatic recovery, Ayurvedic routines, slow travel, and subtle energy by Akhilesh Gowda.",
  "itemListElement": products.map((prod, index) => ({
    "@type": "ListItem",
    "position": index + 1,
    "item": {
      "@type": "Product",
      "name": prod.title,
      "description": prod.description,
      "category": prod.badge,
      "brand": {
        "@type": "Brand",
        "name": "wanderwithakhi"
      },
      "offers": {
        "@type": "Offer",
        "price": "0.00",
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": `https://wanderwithakhi.com${prod.fullUrl}`
      }
    }
  }))
};
---

<BaseLayout title="Digital Product Guides & Printable Workbooks | wanderwithakhi" description="Explore 30-page printable workbooks for daily sadhana, somatic recovery, Ayurvedic routines, slow travel, and subtler yoga practices by Akhilesh Gowda.">
  <script type="application/ld+json" set:html={JSON.stringify(productsSchema)} />
  <Header />

  <main class="products-hub">
    {/* Hero Section */}
    <section class="hub-hero">
      <div class="container">
        <span class="hub-badge">Print-Ready 30-Page Workbooks</span>
        <h1 class="hub-title">Digital Practice Guides & Workbooks</h1>
        <p class="hub-lead">Comprehensive, vector-rendered 8.5x11 inch workbooks designed to anchor your daily yoga practice, somatic stress recovery, Ayurvedic routines, and intentional travel.</p>
      </div>
    </section>

    {/* Products Showcase with Page Overviews */}
    <section class="products-grid-section">
      <div class="container">
        <div class="products-stack">
          {products.map(prod => (
            <article class="product-item-card" id={prod.id}>
              <div class="card-top-bar">
                <div class="meta-left">
                  <span class="product-num" style={`color: ${prod.color}`}>{prod.number}</span>
                  <span class="product-category-tag">{prod.badge}</span>
                </div>
                <span class="specs-pill">30-Page US Letter & A4 Vector PDF / HTML</span>
              </div>

              <div class="card-main-split">
                <div class="info-column">
                  <h2 class="card-title">{prod.title}</h2>
                  <p class="card-subtitle">{prod.subtitle}</p>
                  <p class="card-desc">{prod.description}</p>

                  <div class="cta-row">
                    <a href={prod.fullUrl} class="primary-btn" target="_blank" style={`background-color: ${prod.color}`}>
                      Open Full 30-Page Workbook
                      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5">
                        <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" stroke-linecap="round" stroke-linejoin="round"></path>
                        <polyline points="15 3 21 3 21 9" stroke-linecap="round" stroke-linejoin="round"></polyline>
                        <line x1="10" y1="14" x2="21" y2="3" stroke-linecap="round" stroke-linejoin="round"></line>
                      </svg>
                    </a>
                    <a href={prod.galleryUrl} class="secondary-btn" target="_blank">
                      View Page Gallery
                    </a>
                  </div>
                </div>

                {/* Page-by-Page Overview Box */}
                <div class="overview-box">
                  <h3 class="overview-heading">📄 Page-by-Page Content Overview</h3>
                  <div class="overview-list">
                    {prod.overview.map(item => (
                      <div class="overview-item">
                        <span class="page-range" style={`color: ${prod.color}`}>{item.pages}</span>
                        <div class="page-details">
                          <strong class="page-title">{item.title}</strong>
                          <p class="page-desc">{item.desc}</p>
                        </div>
                      </div>
                    ))}
                  </div>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .products-hub {
    background-color: var(--color-bg);
    min-height: 100vh;
    color: var(--color-text);
    padding-bottom: 6rem;
  }

  .hub-hero {
    padding: 5rem 1.5rem 3rem;
    text-align: center;
    border-bottom: var(--border-thin);
    background-color: rgba(0,0,0,0.015);
  }

  .hub-badge {
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--palette-rust);
    background-color: rgba(200, 122, 83, 0.08);
    padding: 0.45rem 1.15rem;
    border-radius: 4px;
    display: inline-block;
    margin-bottom: 1.5rem;
  }

  .hub-title {
    font-size: 3.25rem;
    line-height: 1.1;
    margin-bottom: 1rem;
  }

  .hub-lead {
    font-family: var(--font-editorial);
    font-style: italic;
    font-size: 1.35rem;
    max-width: 800px;
    margin: 0 auto;
    opacity: 0.8;
    line-height: 1.6;
  }

  .products-grid-section {
    padding: 4rem 1.5rem;
  }

  .products-stack {
    display: flex;
    flex-direction: column;
    gap: 4rem;
    max-width: 1200px;
    margin: 0 auto;
  }

  .product-item-card {
    background-color: var(--color-bg);
    border: var(--border-thin);
    border-radius: 8px;
    padding: 2.5rem;
    box-shadow: 0 4px 20px rgba(0,0,0,0.03);
    transition: var(--transition-smooth);
  }

  .product-item-card:hover {
    box-shadow: 0 10px 30px rgba(0,0,0,0.06);
  }

  .card-top-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid rgba(0,0,0,0.06);
    padding-bottom: 1.25rem;
    margin-bottom: 2rem;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .meta-left {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .product-num {
    font-family: var(--font-sans);
    font-size: 1.75rem;
    font-weight: 800;
  }

  .product-category-tag {
    font-family: var(--font-sans);
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    opacity: 0.7;
  }

  .specs-pill {
    font-family: var(--font-sans);
    font-size: 0.68rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    background-color: var(--palette-chalk);
    padding: 0.35rem 0.85rem;
    border-radius: 30px;
    opacity: 0.8;
  }

  .card-main-split {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
  }

  @media (min-width: 900px) {
    .card-main-split {
      grid-template-columns: 1fr 1fr;
    }
  }

  .card-title {
    font-size: 2.15rem;
    margin-bottom: 0.5rem;
    line-height: 1.2;
  }

  .card-subtitle {
    font-family: var(--font-editorial);
    font-style: italic;
    font-size: 1.15rem;
    opacity: 0.8;
    margin-bottom: 1.25rem;
  }

  .card-desc {
    font-family: var(--font-serif);
    font-size: 1.05rem;
    line-height: 1.65;
    opacity: 0.75;
    margin-bottom: 2.25rem;
  }

  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .primary-btn {
    font-family: var(--font-sans);
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 0.85rem 1.75rem;
    color: #fff;
    border-radius: 4px;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    transition: var(--transition-smooth);
  }

  .primary-btn:hover {
    opacity: 0.9;
    transform: translateY(-2px);
  }

  .secondary-btn {
    font-family: var(--font-sans);
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 0.85rem 1.5rem;
    color: var(--color-text);
    border: var(--border-thin);
    border-radius: 4px;
    text-decoration: none;
    transition: var(--transition-smooth);
  }

  .secondary-btn:hover {
    background-color: var(--palette-chalk);
  }

  /* Overview Box */
  .overview-box {
    background-color: var(--palette-chalk);
    border: var(--border-thin);
    border-radius: 6px;
    padding: 1.75rem;
  }

  .overview-heading {
    font-family: var(--font-sans);
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 1.25rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid rgba(0,0,0,0.06);
  }

  .overview-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .overview-item {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
  }

  .page-range {
    font-family: var(--font-sans);
    font-size: 0.7rem;
    font-weight: 800;
    text-transform: uppercase;
    white-space: nowrap;
    background-color: #fff;
    padding: 0.25rem 0.6rem;
    border-radius: 4px;
    border: 1px solid rgba(0,0,0,0.06);
    flex-shrink: 0;
  }

  .page-title {
    font-size: 0.95rem;
    display: block;
    margin-bottom: 0.2rem;
  }

  .page-desc {
    font-family: var(--font-sans);
    font-size: 0.82rem;
    line-height: 1.45;
    opacity: 0.7;
    margin: 0;
  }
</style>
