---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
---

<BaseLayout title="Nervous System Reset Guide | wanderwithakhi" description="Transform your travels with the 7-Day Somatic Guide and Workbook. Learn to ground travel anxiety, reset digestion, and settle your mind.">
  <Header />

  <main class="sales-portal">
    {/* Hero Section */}
    <section class="hero-split">
      <div class="container hero-container">
        <div class="hero-content">
          <span class="product-badge">New Digital Guide & Workbook</span>
          <h1 class="product-title">Nervous System Reset</h1>
          <p class="product-subtitle">A 7-Day Somatic Guide & Workbook for Solo Travelers</p>
          <p class="product-lead">The print-ready step-by-step roadmap to ground travel anxiety, restore gut health, and establish a state of deep physical safety no matter where you are in the world.</p>
          
          <div class="price-row">
            <span class="current-price">$19.00</span>
            <span class="original-price">$39.00</span>
            <span class="launch-label">Launch Special</span>
          </div>

          <div class="cta-actions">
            <a href="/guides/somatic-travel-reset.html" class="buy-btn" target="_blank">
              Get Free PDF Preview
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" class="btn-icon">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" stroke-linecap="round" stroke-linejoin="round"></path>
                <polyline points="7 10 12 15 17 10" stroke-linecap="round" stroke-linejoin="round"></polyline>
                <line x1="12" y1="15" x2="12" y2="3" stroke-linecap="round" stroke-linejoin="round"></line>
              </svg>
            </a>
            <span class="cta-note">Instant Print-Ready HTML & PDF download</span>
          </div>
        </div>

        <div class="hero-preview">
          <div class="book-mockup">
            <div class="book-spine"></div>
            <div class="book-cover">
              <span class="mockup-brand">Wander With Akhi</span>
              <div class="mockup-title-group">
                <h2 class="mockup-title">Nervous<br/>System<br/>Reset</h2>
                <p class="mockup-subtitle">A 7-Day Somatic Guide</p>
              </div>
              <span class="mockup-author">By Akhi</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* Product Chapters Details */}
    <section class="product-features">
      <div class="container features-container">
        <h2 class="section-title">What's Inside the Guide?</h2>
        <p class="section-subtitle">Over 1,800 words of direct, actionable practices, somatic charts, and reflection tools.</p>

        <div class="chapters-grid">
          <div class="chapter-card">
            <div class="chapter-num">01</div>
            <h3 class="chapter-title">The Physiology of Transition</h3>
            <p class="chapter-text">Learn how transit speeds, sensory overload, and geographic transitions stress your autonomic nervous system, triggering Vata wind imbalances.</p>
          </div>

          <div class="chapter-card">
            <div class="chapter-num">02</div>
            <h3 class="chapter-title">The 7-Day Somatic Protocol</h3>
            <p class="chapter-text">A daily step-by-step roadmap: Lie in constructive rest, visually map new hotels, practice Vata-pacifying nostril breathwork, and massage digestive lockups.</p>
          </div>

          <div class="chapter-card">
            <div class="chapter-num">03</div>
            <h3 class="chapter-title">Somatic Body Map Worksheet</h3>
            <p class="chapter-text">Use the built-in diagnostic body map to track where your body stores tension (throat, solar plexus, gut) and apply specific grounding release commands.</p>
          </div>

          <div class="chapter-card">
            <div class="chapter-num">04</div>
            <h3 class="chapter-title">Weekly Habit Tracker</h3>
            <p class="chapter-text">Keep yourself accountable with our print-ready daily habit tracker. Write down physical shifts and trace your path to peace.</p>
          </div>
        </div>
      </div>
    </section>

    {/* Who is this for? */}
    <section class="target-audience">
      <div class="container target-container">
        <div class="target-header">
          <h2 class="target-title">Is this workbook for you?</h2>
        </div>
        
        <div class="target-split">
          <div class="target-column">
            <h3 class="column-title">This guide is for you if:</h3>
            <ul class="target-list list-check">
              <li>You suffer from travel anxiety, racing thoughts, or spacing out during long transits.</li>
              <li>You experience digestive disruptions (bloating, lockups) whenever you change cities.</li>
              <li>You are a digital nomad struggling with background burnout and sensory overload.</li>
              <li>You want to learn simple, ancient somatic tools to anchor yourself in any country.</li>
            </ul>
          </div>

          <div class="target-column">
            <h3 class="column-title">This is NOT for you if:</h3>
            <ul class="target-list list-cross">
              <li>You prefer packed checklists and sight-seeing marathons over slow-living exploration.</li>
              <li>You are seeking clinical medical advice for chronic nervous disorders.</li>
              <li>You do not want to do physical body-awareness breathing or journaling exercises.</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    {/* Author Section */}
    <section class="author-block">
      <div class="container author-container">
        <div class="author-avatar" style="background-image: url(/images/slow-living.jpg);"></div>
        <div class="author-info">
          <span class="author-tag">Written by Akhilesh Gowda</span>
          <h2 class="author-title">"Your body is your only true country."</h2>
          <p class="author-prose">"After years of exploring ashrams in Mysore, wandering as a slow traveller, and seeking traditional Indian spiritual lineages, I realized that true rest is never about the destination. It is a state of inner silence. I wrote this guide to share the simple grounding practices that kept me centered through crowded trains and chaotic border crossings. I hope they serve as your anchor on the road."</p>
        </div>
      </div>
    </section>

    {/* CTA Block */}
    <section class="final-cta">
      <div class="container cta-container">
        <h2 class="cta-title">Settle into your journey today.</h2>
        <p class="cta-desc">Download your free copy of the print-ready Somatic Travel Guide and start resetting your body.</p>
        <a href="/guides/somatic-travel-reset.html" class="buy-btn btn-large" target="_blank">Download Guide PDF / HTML</a>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .sales-portal {
    background-color: var(--color-bg);
    min-height: 100vh;
    color: var(--color-text);
  }

  /* Hero Split Layout */
  .hero-split {
    padding: 6rem 1.5rem;
    border-bottom: var(--border-thin);
  }

  .hero-container {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: 4rem;
    align-items: center;
  }

  @media (min-width: 1024px) {
    .hero-container {
      grid-template-columns: 1.2fr 0.8fr;
    }
  }

  .product-badge {
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--palette-rust);
    background-color: rgba(200, 122, 83, 0.05);
    padding: 0.45rem 1rem;
    border-radius: 4px;
    display: inline-block;
    margin-bottom: 1.75rem;
  }

  .product-title {
    font-size: 3.5rem;
    line-height: 1.05;
    margin-bottom: 0.5rem;
    color: var(--color-text);
  }

  .product-subtitle {
    font-family: var(--font-editorial);
    font-style: italic;
    font-size: 1.75rem;
    opacity: 0.8;
    margin-bottom: 2rem;
  }

  .product-lead {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    line-height: 1.7;
    opacity: 0.75;
    margin-bottom: 2.5rem;
  }

  /* Price Row */
  .price-row {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 3rem;
  }

  .current-price {
    font-size: 2.5rem;
    font-weight: 700;
    color: var(--palette-rust);
  }

  .original-price {
    font-size: 1.5rem;
    text-decoration: line-through;
    opacity: 0.4;
  }

  .launch-label {
    font-family: var(--font-sans);
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    background-color: #faf9f6;
    border: 1px solid var(--palette-rust);
    color: var(--palette-rust);
    padding: 0.25rem 0.75rem;
    border-radius: 30px;
  }

  /* CTA actions */
  .cta-actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
  }

  .buy-btn {
    font-family: var(--font-sans);
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 1rem 2.5rem;
    background-color: var(--palette-rust);
    color: #fff;
    border: none;
    border-radius: 4px;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    transition: var(--transition-smooth);
    box-shadow: 0 4px 14px rgba(200, 122, 83, 0.25);
  }

  .buy-btn:hover {
    opacity: 0.95;
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(200, 122, 83, 0.35);
  }

  .btn-icon {
    transition: transform 0.3s ease;
  }

  .buy-btn:hover .btn-icon {
    transform: translateY(2px);
  }

  .cta-note {
    font-family: var(--font-sans);
    font-size: 0.7rem;
    opacity: 0.5;
    margin-left: 0.25rem;
  }

  /* Book Mockup Preview */
  .hero-preview {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .book-mockup {
    width: 280px;
    height: 380px;
    display: flex;
    box-shadow: 15px 15px 30px rgba(0,0,0,0.06), -5px -5px 10px rgba(255,255,255,0.8);
    border-radius: 0 6px 6px 0;
    overflow: hidden;
    background-color: var(--palette-rust);
  }

  .book-spine {
    width: 20px;
    background: linear-gradient(90deg, rgba(0,0,0,0.15) 0%, rgba(255,255,255,0.08) 50%, rgba(0,0,0,0.2) 100%);
    border-right: 1px solid rgba(0,0,0,0.1);
  }

  .book-cover {
    flex-grow: 1;
    background: var(--palette-rust);
    padding: 3rem 2rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    color: #fff;
  }

  .mockup-brand {
    font-family: var(--font-sans);
    font-size: 0.65rem;
    text-transform: uppercase;
    font-weight: 700;
    letter-spacing: 0.15em;
    opacity: 0.8;
  }

  .mockup-title {
    font-family: var(--font-sans);
    font-size: 2.25rem;
    line-height: 1.1;
    font-weight: 700;
    margin-bottom: 0.75rem;
  }

  .mockup-subtitle {
    font-family: var(--font-editorial);
    font-style: italic;
    font-size: 1.15rem;
    opacity: 0.9;
  }

  .mockup-author {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    opacity: 0.8;
  }

  /* Chapter Details Section */
  .product-features {
    background-color: var(--palette-chalk);
    border-bottom: var(--border-thin);
    padding: 6rem 1.5rem;
  }

  .features-container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .section-title {
    font-size: 2.25rem;
    text-align: center;
    margin-bottom: 0.5rem;
  }

  .section-subtitle {
    font-family: var(--font-editorial);
    font-style: italic;
    font-size: 1.25rem;
    text-align: center;
    opacity: 0.7;
    margin-bottom: 4.5rem;
  }

  .chapters-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }

  @media (min-width: 768px) {
    .chapters-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .chapter-card {
    background-color: var(--color-bg);
    border: var(--border-thin);
    padding: 2.5rem;
    border-radius: 6px;
    position: relative;
    overflow: hidden;
  }

  .chapter-num {
    font-size: 4rem;
    font-family: var(--font-sans);
    font-weight: 800;
    color: var(--palette-rust);
    opacity: 0.05;
    position: absolute;
    top: 0.5rem;
    right: 1.5rem;
    line-height: 1;
  }

  .chapter-title {
    font-size: 1.35rem;
    margin-bottom: 0.75rem;
    color: var(--color-text);
  }

  .chapter-text {
    font-family: var(--font-serif);
    font-size: 1.05rem;
    line-height: 1.6;
    opacity: 0.75;
    margin: 0;
  }

  /* Target Audience lists */
  .target-audience {
    padding: 6rem 1.5rem;
    border-bottom: var(--border-thin);
  }

  .target-container {
    max-width: 1000px;
    margin: 0 auto;
  }

  .target-title {
    font-size: 2.25rem;
    text-align: center;
    margin-bottom: 4rem;
  }

  .target-split {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3.5rem;
  }

  @media (min-width: 768px) {
    .target-split {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .column-title {
    font-family: var(--font-sans);
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: 700;
    margin-bottom: 1.75rem;
  }

  .target-list {
    list-style: none;
    padding: 0;
  }

  .target-list li {
    font-family: var(--font-serif);
    font-size: 1.1rem;
    line-height: 1.6;
    margin-bottom: 1.25rem;
    position: relative;
    padding-left: 2rem;
  }

  /* List bullets (check vs cross) */
  .list-check li::before {
    content: "✓";
    position: absolute;
    left: 0;
    color: var(--palette-sage);
    font-weight: 700;
  }

  .list-cross li::before {
    content: "✕";
    position: absolute;
    left: 0;
    color: var(--palette-rust);
    font-weight: 700;
  }

  /* Author block */
  .author-block {
    background-color: var(--palette-chalk);
    border-bottom: var(--border-thin);
    padding: 6rem 1.5rem;
  }

  .author-container {
    max-width: 900px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: 3.5rem;
    align-items: center;
  }

  @media (min-width: 768px) {
    .author-container {
      grid-template-columns: 0.8fr 1.2fr;
    }
  }

  .author-avatar {
    width: 100%;
    height: 380px;
    background-size: cover;
    background-position: center;
    border: var(--border-thin);
    border-radius: 6px;
    box-shadow: 0 8px 24px rgba(0,0,0,0.03);
  }

  .author-tag {
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--palette-rust);
    margin-bottom: 1rem;
    display: block;
  }

  .author-title {
    font-family: var(--font-editorial);
    font-style: italic;
    font-size: 2rem;
    line-height: 1.25;
    margin-bottom: 1.5rem;
  }

  .author-prose {
    font-family: var(--font-serif);
    font-size: 1.1rem;
    line-height: 1.7;
    opacity: 0.75;
    margin: 0;
  }

  /* Final CTA Block */
  .final-cta {
    padding: 7rem 1.5rem;
    text-align: center;
  }

  .cta-container {
    max-width: 700px;
    margin: 0 auto;
  }

  .cta-title {
    font-size: 2.75rem;
    margin-bottom: 0.75rem;
  }

  .cta-desc {
    font-family: var(--font-editorial);
    font-style: italic;
    font-size: 1.35rem;
    opacity: 0.75;
    margin-bottom: 3.5rem;
  }

  .btn-large {
    padding: 1.25rem 3.5rem;
    font-size: 0.9rem;
  }
</style>
