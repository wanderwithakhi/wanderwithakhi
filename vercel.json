{
  "redirects": [
    {
      "source": "/essays/:type/:slug",
      "destination": "/blog/:type/:slug",
      "permanent": true
    },
    {
      "source": "/essays/:path*",
      "destination": "/blog/:path*",
      "permanent": true
    },
    {
      "source": "/sitemap.xml",
      "destination": "/sitemap-index.xml",
      "permanent": true
    }
  ]
}
